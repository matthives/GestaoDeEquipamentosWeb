@model List<ListarEquipamentoViewModel>

@{
    Layout = "_Layout";
    ViewBag.Titulo = "Listagem de Equipamentos";
}

<p>
    <a class="btn btn-primary" asp-action="Cadastrar">
        <i class="bi bi-patch-plus"></i>
        Cadastrar chamado
    </a>
</p>

@if (Model.Count == 0)
{
    <div class="alert alert-warning mt-4" role="alert">
        Não há nenhum chamado registrado.
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3 mt-4">
        @foreach (ListarChamadoViewModel chamado in Model)
        {
            <div class="col">
                <div class="card h-100">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h5>@chamado.Nome</h5>
                            <span class="badge text-bg-secondary">@chamado.Id</span>
                        </div>

                        <dl class="row mb-2">
                            <dt class="col-sm-5">Preço</dt>
                            <dd class="col-sm-7">@chamado.PrecoAquisicao.ToString("C2")</dd>

                            <dt class="col-sm-5">Fabricante</dt>
                            <dd class="col-sm-7">@chamado.NomeFabricante</dd>

                            <dt class="col-sm-5">Fabricação</dt>
                            <dd class="col-sm-7">@chamado.DataFabricacao.ToString("dd/MM/yyyy")</dd>
                        </dl>

                        <div class="d-flex gap-2 justify-content-end mt-auto">
                            <a class="btn btn-sm btn-outline-primary" title="Editar" asp-action="Editar"
                               asp-route-id="@chamado.Id">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <a class="btn btn-sm btn-outline-danger" title="Excluir" asp-action="Excluir"
                               asp-route-id="@equipamento.Id">
                                <i class="bi bi-trash3"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}